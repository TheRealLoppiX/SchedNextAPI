PORT=4000

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

FRONTEND_URL=http://localhost:3000

# Supabase (Postgres), usados em runtime pelo backend (src/config/supabase.js)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (Gmail SMTP via nodemailer), usado em runtime pelo backend
# (src/config/mailer.js). GMAIL_PASS é uma Senha de App do Google, não a senha normal da
# conta (myaccount.google.com/apppasswords, exige verificação em 2 etapas ativada).
GMAIL_USER=
GMAIL_PASS=

# Groq (recursos de IA, gated pro plano Profissional/Enterprise), usado em runtime pelo
# backend (src/services/groq.js). Gere em console.groq.com/keys
GROQ_API_KEY=

# WhatsApp, Meta Cloud API (src/services/whatsapp/provider.js). Token temporário/permanente
# e phone_number_id vêm do App em developers.facebook.com. WHATSAPP_VERIFY_TOKEN é uma string
# qualquer que você escolhe, usada só no handshake de verificação do webhook.
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Segredo compartilhado temporário pro /pagamentos/webhook (src/routes/pagamentos.js). Vai
# no header X-Webhook-Secret. Só existe porque ainda não há gateway real configurado (nenhum
# tem assinatura própria pra validar ainda); trocar pela verificação de assinatura do gateway
# escolhido (Mercado Pago/Asaas/Pagar.me) assim que a integração real for feita.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAGAMENTOS_WEBHOOK_SECRET=
