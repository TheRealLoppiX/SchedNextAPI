PORT=4000

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

FRONTEND_URL=http://localhost:3000
# URL pública do próprio backend, usada só pra registrar o webhook do WhatsApp na criação de
# cada instância (src/services/whatsapp/provider.js). Em produção: https://schednextapi.onrender.com
BACKEND_URL=http://localhost:4000

# Supabase (Postgres), usados em runtime pelo backend (src/config/supabase.js)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (Gmail SMTP via nodemailer), usado em runtime pelo backend
# (src/config/mailer.js). GMAIL_PASS é uma Senha de App do Google, não a senha normal da
# conta (myaccount.google.com/apppasswords, exige verificação em 2 etapas ativada).
GMAIL_USER=
GMAIL_PASS=

# Groq (recursos de IA, gated pro plano Profissional/Enterprise), usado em runtime pelo
# backend (src/services/groq.js). Gere em console.groq.com/keys
GROQ_API_KEY=

# WhatsApp, Evolution API self-hosted (src/services/whatsapp/provider.js). EVOLUTION_API_URL é
# o endereço da VPS (ex: https://evolution.seudominio.com), EVOLUTION_API_KEY é a
# AUTHENTICATION_API_KEY configurada no próprio Evolution (ver docs.evolution-api.com). Servidor
# único pra plataforma inteira, mas cada empresa tem sua própria instância dentro dele — o nome
# de cada instância é gerenciado por routes/whatsappInstancia.js, guardado em
# empresas.whatsapp_phone_number_id, não é mais uma env var fixa.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Mercado Pago — cobre TODA cobrança do sistema agora (Asaas foi descontinuado):
#
# 1) Pix avulso do agendamento/PDV — uma conta por EMPRESA via OAuth (src/routes/mercadopago.js,
#    src/services/mercadopago.js). Client ID/Secret vêm do painel de desenvolvedor do Mercado
#    Pago (aplicação da SchedNext, não a de cada barbearia) em Suas integrações → [sua
#    aplicação] → Credenciais de produção. Cadastre a Redirect URI como
#    {BACKEND_URL}/mercadopago/oauth/callback nas configurações da aplicação.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# 2) Assinatura recorrente DA PLATAFORMA (empresa paga a SchedNext pelo plano — src/services/
#    pagamento.js). Access Token de produção da conta DONA da aplicação (painel Credenciais,
#    não o fluxo OAuth acima) — é a SchedNext vendendo direto, sem intermediário.
MERCADOPAGO_PLATAFORMA_ACCESS_TOKEN=

# Webhook Secret Key (mesma aplicação → Webhooks → configurar notificações → chave secreta).
# Usada pra validar a assinatura de POST /webhooks/mercadopago (src/routes/mercadopago.js) —
# cobre pagamento avulso E assinatura/preapproval (marcar os dois eventos no painel: "Pagamentos
# (legacy)" e "Planos e assinaturas"). Sem isso configurado a rota recusa toda chamada
# (fail-closed).
MERCADOPAGO_WEBHOOK_SECRET=

# Login do(s) "admin absoluto(s)" (donos da plataforma, src/routes/superAdmin.js) — agora
# ficam na tabela `super_admins` do Supabase, não mais em variável de ambiente. O primeiro
# super admin precisa ser inserido manualmente nessa tabela (hash bcrypt da senha, nunca a
# senha em texto puro); a partir daí, qualquer super admin já logado pode criar outro por
# POST /super-admin/super-admins (restrito a e-mail @schednext.com.br).
