PORT=4000

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

FRONTEND_URL=http://localhost:3000

# Supabase (Postgres), usados em runtime pelo backend (src/config/supabase.js)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (Gmail SMTP via nodemailer), usado em runtime pelo backend
# (src/config/mailer.js). GMAIL_PASS é uma Senha de App do Google, não a senha normal da
# conta (myaccount.google.com/apppasswords, exige verificação em 2 etapas ativada).
GMAIL_USER=
GMAIL_PASS=

# Groq (recursos de IA, gated pro plano Profissional/Enterprise), usado em runtime pelo
# backend (src/services/groq.js). Gere em console.groq.com/keys
GROQ_API_KEY=

# WhatsApp, Evolution API self-hosted (src/services/whatsapp/provider.js). EVOLUTION_API_URL é
# o endereço do seu VPS (ex: http://SEU_IP:8080), EVOLUTION_API_KEY é a AUTHENTICATION_API_KEY
# configurada no próprio Evolution, e EVOLUTION_INSTANCE é o nome da instância criada (ver
# docs.evolution-api.com). Único número pra plataforma inteira por enquanto.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Asaas (gateway de cobrança da plataforma, src/services/asaas.js e src/services/pagamento.js).
# ASAAS_API_KEY é a chave de API gerada em Configurações → Integrações → API no painel do Asaas
# (sandbox.asaas.com pra testar, asaas.com pra produção). ASAAS_ENV = "sandbox" ou "production".
ASAAS_API_KEY=
ASAAS_ENV=production

# Token de autenticação do webhook do Asaas (Integrações → Webhooks → aponte pra
# https://SEU_BACKEND/pagamentos/webhook e defina esse mesmo valor como "Token de autenticação").
# Reenviado pelo Asaas no header asaas-access-token em todo POST; sem isso configurado a rota
# recusa qualquer chamada (fail-closed).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASAAS_WEBHOOK_TOKEN=

# Login do "admin absoluto" (dono da plataforma, src/routes/superAdmin.js) — conta única, sem
# tabela própria. SUPER_ADMIN_SENHA_HASH é um hash bcrypt, NUNCA a senha em texto puro. Gere
# rodando dentro de backend/: node -e "console.log(require('bcrypt').hashSync('SUA_SENHA', 12))"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_SENHA_HASH=
