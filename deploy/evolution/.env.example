# Copie este arquivo pra ".env" nesta mesma pasta (deploy/evolution/) na VPS antes de rodar
# "docker compose up -d". Nunca commitar o ".env" de verdade (só este .example fica no git).

# Senha inventada por você mesmo (ex: gere com: openssl rand -hex 24).
# Vira o valor de EVOLUTION_API_KEY no .env do backend (schednext).
AUTHENTICATION_API_KEY=

# Senha do Postgres interno do Evolution (não é o Supabase de produção, é um Postgres
# separado só pra guardar sessão/histórico do Evolution). Gere com: openssl rand -hex 16
POSTGRES_PASSWORD=
